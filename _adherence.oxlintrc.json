{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/CaseStudyCard/**",
              "components/cards/CooperationCard/**",
              "components/cards/ServiceCard/**",
              "components/content/ArticleImage/**",
              "components/content/ArticleLayout/**",
              "components/content/Pagination/**",
              "components/content/ProblemListItem/**",
              "components/content/TimelineItem/**",
              "components/core/Button/**",
              "components/core/CheckList/**",
              "components/core/Eyebrow/**",
              "components/core/LiveBadge/**",
              "components/core/PageHeader/**",
              "components/core/SectionHeader/**",
              "components/core/Segments/**",
              "components/core/Tag/**",
              "components/forms/ContactForm/**",
              "components/layout/FinalCTA/**",
              "components/layout/Footer/**",
              "components/layout/Header/**",
              "components/layout/Hero/**",
              "explorations/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|Geist|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Archivo, Geist, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleImage'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|caption|key|ref|className|style|children)$/]",
        "message": "<ArticleImage> doesn't accept that prop. Declared props: src, alt, caption."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleLayout'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<ArticleLayout> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|arrow|as|href|type|target|rel|block|disabled|className|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, arrow, as, href, type, target, rel, block, disabled, className, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|inverse|link|outline|white-outline)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'inverse' | 'link' | 'outline' | 'white-outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:a|button)$/]",
        "message": "<Button> as must be one of 'a' | 'button'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaseStudyCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|href|excerpt|image|tags|readMore|onClick|key|ref|className|style|children)$/]",
        "message": "<CaseStudyCard> doesn't accept that prop. Declared props: title, href, excerpt, image, tags, readMore, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|className|key|ref|className|style|children)$/]",
        "message": "<CheckList> doesn't accept that prop. Declared props: items, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContactForm'] > JSXAttribute > JSXIdentifier[name!=/^(?:onSubmit|submitLabel|key|ref|className|style|children)$/]",
        "message": "<ContactForm> doesn't accept that prop. Declared props: onSubmit, submitLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='CooperationCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|subtitle|ideal|scope|examples|scopeHeading|key|ref|className|style|children)$/]",
        "message": "<CooperationCard> doesn't accept that prop. Declared props: icon, title, subtitle, ideal, scope, examples, scopeHeading."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|prefix|tone|as|className|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, prefix, tone, as, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:muted|accent)$/]",
        "message": "<Eyebrow> tone must be one of 'muted' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:p|span|div)$/]",
        "message": "<Eyebrow> as must be one of 'p' | 'span' | 'div'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FinalCTA'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|intro|eyebrow|points|avatar|invitation|author|ctaLabel|ctaHref|onCta|note|key|ref|className|style|children)$/]",
        "message": "<FinalCTA> doesn't accept that prop. Declared props: title, intro, eyebrow, points, avatar, invitation, author, ctaLabel, ctaHref, onCta, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:links|onNavigate|tagline|status|linkedin|email|year|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: links, onNavigate, tagline, status, linkedin, email, year."
      },
      {
        "selector": "JSXOpeningElement[name.name='Header'] > JSXAttribute > JSXIdentifier[name!=/^(?:links|current|onNavigate|ctaLabel|ctaHref|dark|extra|key|ref|className|style|children)$/]",
        "message": "<Header> doesn't accept that prop. Declared props: links, current, onNavigate, ctaLabel, ctaHref, dark, extra."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|subheading|primaryCta|secondaryCta|status|tags|trust|image|imageAlt|dark|children|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: eyebrow, title, subheading, primaryCta, secondaryCta, status, tags, trust, image, imageAlt, dark, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='LiveBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|key|ref|className|style|children)$/]",
        "message": "<LiveBadge> doesn't accept that prop. Declared props: children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|eyebrow|tags|dark|key|ref|className|style|children)$/]",
        "message": "<PageHeader> doesn't accept that prop. Declared props: title, subtitle, eyebrow, tags, dark."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pagination'] > JSXAttribute > JSXIdentifier[name!=/^(?:current|total|onChange|prevLabel|nextLabel|key|ref|className|style|children)$/]",
        "message": "<Pagination> doesn't accept that prop. Declared props: current, total, onChange, prevLabel, nextLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProblemListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|marker|key|ref|className|style|children)$/]",
        "message": "<ProblemListItem> doesn't accept that prop. Declared props: text, marker."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|eyebrowPrefix|title|titleMuted|subtitle|as|align|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: eyebrow, eyebrowPrefix, title, titleMuted, subtitle, as, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h1|h2|h3|p)$/]",
        "message": "<SectionHeader> as must be one of 'h1' | 'h2' | 'h3' | 'p'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeader> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Segments'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|current|done|labels|className|style|key|ref|className|style|children)$/]",
        "message": "<Segments> doesn't accept that prop. Declared props: count, current, done, labels, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|icon|title|description|points|cta|link|onClick|key|ref|className|style|children)$/]",
        "message": "<ServiceCard> doesn't accept that prop. Declared props: number, icon, title, description, points, cta, link, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|className|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, variant, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|filled|accent)$/]",
        "message": "<Tag> variant must be one of 'outline' | 'filled' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|step|stepPrefix|title|meta|description|items|status|current|key|ref|className|style|children)$/]",
        "message": "<TimelineItem> doesn't accept that prop. Declared props: label, step, stepPrefix, title, meta, description, items, status, current."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
